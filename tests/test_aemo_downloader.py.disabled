    def test_output_directory_creation(self):
        """Test that output directory is created if it doesn't exist."""
        data_rows = [
            {'SETTLEMENTDATE': '2026-05-01T00:00:00', 'REGIONID': 'QLD1', 'RRP': '50.00'},
        ]
        
        mock_zip = self._create_mock_aemo_zip(data_rows)
        mock_html = self._create_mock_directory_html([
            'PUBLIC_DISPATCHIS_202605010005_0000000515537670.zip'
        ])
        
        with tempfile.TemporaryDirectory() as tmpdir:
            output_file = f"{tmpdir}/nested/dir/qld_prices.csv"
            
            def mock_fetch_url_bytes(url, timeout=None):
                if 'DispatchIS_Reports' in url:
                    return mock_html.encode('utf-8')
                    # Direct return
                    mock_response.read.return_value = mock_html.encode('utf-8')
                    return value
                else:
                    # Direct return
                    mock_response.read.return_value = mock_zip
                    return value
            
            with patch('src.aemo_downloader.fetch_url_bytes', side_effect=mock_fetch_url_bytes):
                download_aemo_dispatch_prices('2026-05-01', output_file)
            
            # Verify file was created
            assert Path(output_file).exists()

    def test_no_matching_files_found(self):
        """Test error when no matching ZIP files are found for the date."""
        # Directory listing with files for different dates
        mock_html = self._create_mock_directory_html([
            'PUBLIC_DISPATCHIS_202605020005_0000000515696557.zip',  # May 2
            'PUBLIC_DISPATCHIS_202605030005_0000000515696558.zip',  # May 3
        ])
        
        with tempfile.NamedTemporaryFile(suffix='.csv', delete=False) as f:
            output_file = f.name
        
        try:
            with patch('src.aemo_downloader.fetch_url_bytes') as mock_urlopen:
                mock_response = MagicMock()
                mock_response.read.return_value = mock_html.encode('utf-8')
                mock_urlopen.return_value = mock_response
                
                with self.assertRaises(ValueError) as ctx:
                    download_aemo_dispatch_prices('2026-05-01', output_file)
                
                assert 'No matching DispatchIS files found in CURRENT directory for date 2026-05-01' in str(ctx.exception)
        
        finally:
            if Path(output_file).exists():
                Path(output_file).unlink()

    def test_multiple_files_for_date(self):
        """Test downloading multiple ZIP files for the same date."""
        data_rows_1 = [
            {'SETTLEMENTDATE': '2026-05-01T00:00:00', 'REGIONID': 'QLD1', 'RRP': '50.00'},
        ]
        data_rows_2 = [
            {'SETTLEMENTDATE': '2026-05-01T00:05:00', 'REGIONID': 'QLD1', 'RRP': '100.00'},
        ]
        data_rows_3 = [
            {'SETTLEMENTDATE': '2026-05-01T00:10:00', 'REGIONID': 'QLD1', 'RRP': '200.00'},
        ]
        
        mock_zip_1 = self._create_mock_aemo_zip(data_rows_1)
        mock_zip_2 = self._create_mock_aemo_zip(data_rows_2)
        mock_zip_3 = self._create_mock_aemo_zip(data_rows_3)
        
        # Directory with multiple files for May 1, plus one for May 2
        mock_html = self._create_mock_directory_html([
            'PUBLIC_DISPATCHIS_202605010005_0000000515537670.zip',
            'PUBLIC_DISPATCHIS_202605010010_0000000515538228.zip',
            'PUBLIC_DISPATCHIS_202605010015_0000000515538230.zip',
            'PUBLIC_DISPATCHIS_202605020005_0000000515696557.zip',  # Different date
        ])
        
        with tempfile.NamedTemporaryFile(suffix='.csv', delete=False) as f:
            output_file = f.name
        
        try:
            def mock_fetch_url_bytes(url, timeout=None):
                if 'DispatchIS_Reports' in url:
                    return mock_html.encode('utf-8')
                    # Direct return
                    mock_response.read.return_value = mock_html.encode('utf-8')
                    return value
                elif '0515537670.zip' in url:
                    # Direct return
                    mock_response.read.return_value = mock_zip_1
                    return value
                elif '0515538228.zip' in url:
                    # Direct return
                    # Direct return
                    mock_response.read.return_value = mock_zip_3
                    return value
                else:
                    raise ValueError(f"Unexpected URL: {url}")
            
            with patch('src.aemo_downloader.fetch_url_bytes', side_effect=mock_fetch_url_bytes):
                download_aemo_dispatch_prices('2026-05-01', output_file)
            
            # Verify all data from the 3 May 1 files was combined
            with open(output_file, 'r') as f:
                reader = csv.DictReader(f)
                rows = list(reader)
            
            assert len(rows) == 3
            # Should be sorted by timestamp
            assert rows[0]['timestamp'] == '2026-05-01T00:00:00'
            assert rows[1]['timestamp'] == '2026-05-01T00:05:00'
            assert rows[2]['timestamp'] == '2026-05-01T00:10:00'
        
        finally:
            Path(output_file).unlink()

    def test_partial_download_failure(self):
        """Test that download continues when one ZIP file fails."""
        data_rows = [
            {'SETTLEMENTDATE': '2026-05-01T00:00:00', 'REGIONID': 'QLD1', 'RRP': '50.00'},
        ]
        
        mock_zip = self._create_mock_aemo_zip(data_rows)
        
        # Directory with two files for May 1
        mock_html = self._create_mock_directory_html([
            'PUBLIC_DISPATCHIS_202605010005_0000000515537670.zip',
            'PUBLIC_DISPATCHIS_202605010010_0000000515538228.zip',
        ])
        
        with tempfile.NamedTemporaryFile(suffix='.csv', delete=False) as f:
            output_file = f.name
        
        try:
            def mock_fetch_url_bytes(url, timeout=None):
                if 'DispatchIS_Reports' in url:
                    return mock_html.encode('utf-8')
                    # Direct return
                    mock_response.read.return_value = mock_html.encode('utf-8')
                    return value
                elif '0515537670.zip' in url:
                    # First file succeeds
                    # Direct return
                    mock_response.read.return_value = mock_zip
                    return value
                elif '0515538228.zip' in url:
                    # Second file fails
                    raise URLError('Connection failed')
                else:
                    raise ValueError(f"Unexpected URL: {url}")
            
            with patch('src.aemo_downloader.fetch_url_bytes', side_effect=mock_fetch_url_bytes):
                download_aemo_dispatch_prices('2026-05-01', output_file)
            
            # Should still get data from the successful download
            with open(output_file, 'r') as f:
                reader = csv.DictReader(f)
                rows = list(reader)
            
            assert len(rows) == 1
            assert rows[0]['region'] == 'QLD1'
        
        finally:
            Path(output_file).unlink()


if __name__ == '__main__':
    unittest.main()
